[Unit]
Description=SD SCM legal risk expired import cleanup
After=network-online.target mysql.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/sd-scm/backend
EnvironmentFile=/opt/sd-scm/backend/.env
ExecStart=/opt/sd-scm/backend/.venv/bin/python -m app.jobs.legal_import_cleanup

[Install]
WantedBy=multi-user.target
